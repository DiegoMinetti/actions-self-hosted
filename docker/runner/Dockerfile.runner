# =============================================================================
# Imagen del runner de GitHub Actions.
#
# BASE: la imagen OFICIAL de GitHub (`ghcr.io/actions/actions-runner`), que trae
# el binario `Runner.Listener` sin tocar y todo el toolchain (node, externals).
# Es multi-arch: el mismo Dockerfile produce linux/amd64 y linux/arm64.
#
# POR QUÉ EXISTE ESTE WRAPPER (y por qué no se usa la oficial directo):
#
# 1. La imagen oficial NO trae ENTRYPOINT — solo `CMD ["/bin/bash"]`. Docker
#    arranca el container en bash y el listener del runner nunca corre.
# 2. La imagen oficial NO auto-configura: su `run.sh` invoca el listener pero
#    nunca llama a `config.sh`, así que sin credenciales en disco el listener
#    falla con "Not configured" y entra en loop.
#
#QUÉ LE AGREGAMOS:
#
# 1. Un ENTRYPOINT propio (`entrypoint.sh`) que hace el flow completo:
#    restaurar credenciales -> config.sh si hace falta -> exec del listener.
# 2. Un punto de montage nuevo para la persistencia: `/runner-data`.
#
# POR QUÉ `/runner-data` Y NO `/home/runner` (que es donde la imagen oficial
# guarda bin/, externals/, config.sh y run.sh):
#
# El work dir del runner TIENE que ser `/home/runner`, porque el listener lee
# el archivo `.runner` desde el CWD. Si montamos el volumen persistente ahí,
# el volumen pisa la distribución oficial y quedan congelados los binarios de
# la versión con la que se creó el volumen. Reproducido: un volumen creado con
# la 2.328.0 seguía sirviendo los binarios de 2.328.0 después de correr la
# imagen 2.338.0. O sea, el tag de la imagen era cosmético y "Recreate" no
# actualizaba el runner.
#
# Con este diseño:
#   - `/home/runner`  -> efímero, viene SIEMPRE de la imagen oficial.
#                         El tag de la imagen ES la versión real del runner.
#   - `/runner-data`  -> volumen persistente con SOLO credenciales (unos pocos
#                         KB): `.runner`, `.credentials`, `.credentials_rsaparams`,
#                         `.env` y `.path`. Sobreviven a stop/start y recreate,
#                         que es lo único que hay que preservar.
#
#                         OJO con el set completo: sin `.credentials_rsaparams` el
#                         listener muere con "RSA key file ... was not found" y
#                         el runner queda offline para siempre.
#
# Build (normalmente lo hace compose, no hace falta a mano):
#   docker compose build runner-image
#
# Build manual:
#   docker build -f docker/runner/Dockerfile.runner \
#     --build-arg RUNNER_VERSION=2.338.0 \
#     -t actions-self-hosted-runner:2.338.0 docker/runner
# =============================================================================

ARG RUNNER_VERSION=2.338.0
FROM ghcr.io/actions/actions-runner:${RUNNER_VERSION}

# El usuario por defecto de la imagen oficial es `runner` (uid 1001). Hacemos
# el setup como root y al final volvemos a `runner` para no cambiar el
# comportamiento de la imagen oficial.
USER root

# Directorio de persistencia (volumen montado por la app).
# Tiene que quedar con permisos 0777 y owner `runner` porque el container corre
# como `1001:0` (ver `apps/api/src/docker/containers.ts`): el volumen toma
# owner y permisos del punto de montaje de la imagen.
RUN mkdir -p /runner-data \
    && chown runner:runner /runner-data \
    && chmod 0777 /runner-data

# El entrypoint va en /usr/local/bin y NO en /home/runner: ese directorio es
# el work dir del runner y la app monta un volumen ahí en algunos flujos.
#
# Se hace `COPY` + `chmod` en vez de `COPY --chmod` para que el Dockerfile
# también compile con el builder clásico (sin BuildKit), que es el que usan
# algunos CI. Con BuildKit el `--chmod` evita una capa extra, pero no vale
# la pena perder la compatibilidad.
COPY entrypoint.sh /usr/local/bin/runner-entrypoint.sh
RUN chmod 755 /usr/local/bin/runner-entrypoint.sh

USER runner

# `RUNNER_ALLOW_RUNASROOT=1` porque la imagen oficial corre como root adentro
# y su `run.sh` valida esto. La app también la pasa como env en runtime
# (containers.ts), así que este ENV es solo un fallback.
# `ACTIONS_RUNNER_PRINT_LOG_TO_STDOUT=1` saca los logs del listener a stdout
# (si no, se pierden al reiniciar el container).
ENV RUNNER_ALLOW_RUNASROOT=1 \
    ACTIONS_RUNNER_PRINT_LOG_TO_STDOUT=1 \
    DEBIAN_FRONTEND=noninteractive \
    RUNNER_DATA_DIR=/runner-data \
    RUNNER_WORK_DIR=/home/runner

ENTRYPOINT ["/usr/local/bin/runner-entrypoint.sh"]
CMD ["run"]
