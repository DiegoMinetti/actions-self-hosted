# ============================================
# ActionsSelfHosted - Environment variables
# ============================================
# Copy this file to `.env` and adjust as needed.

# --- API ---
# Puerto donde escucha el backend Express.
API_PORT=3000

# Entorno: development | production
NODE_ENV=development

# CORS origin permitido para el frontend en dev.
# En producción, el frontend se sirve desde el mismo origen.
CORS_ORIGIN=http://localhost:5173

# --- Persistencia ---
# Path al archivo SQLite de metadata de runners.
# Default: data/runners.db relativo al proyecto.
DB_PATH=data/runners.db

# --- Docker ---
# Socket de Docker. Default por OS:
#   macOS / Linux:  /var/run/docker.sock
#   Windows:        //./pipe/docker_engine
# Si está vacío, se autodetecta.
DOCKER_SOCKET=

# Nombre del "compose project" que se usa como label en los containers
# y volúmenes que crea la app. Aparece como header agrupador en Docker
# Desktop. Si lo cambiás, también cambiá `name:` en docker-compose.yml
# para que la app y los runners queden en el mismo grupo.
COMPOSE_PROJECT_NAME=actions-self-hosted

# --- Runner ---
# Versión del runner de GitHub Actions.
#
# Esta es la ÚNICA variable que hay que tocar para actualizar el runner:
# define la imagen oficial base (`ghcr.io/actions/actions-runner:<version>`)
# que usa el wrapper, y la app deriva de acá el tag de la imagen que crea.
#
# Para actualizar: cambiá el valor, corré `docker compose up -d --build`, y
# recreá los runners desde el panel (o POST /api/runners/:id/recreate).
RUNNER_VERSION=2.338.0

# Tag de la imagen del runner que usa la app. Normalmente se deriva de
# RUNNER_VERSION; solo completalo si la imagen vive en un registry en vez de
# ser la local que construye compose.
# RUNNER_IMAGE=actions-self-hosted-runner:2.338.0

# --- Web ---
# Puerto del Vite dev server.
WEB_PORT=5173

# --- Auth ---
# Usuario y password básicos para proteger el panel y la API.
#
# Si quedan vacíos, la auth queda DESHABILITADA. En producción NO puede
# quedar así: la API tiene el socket Docker montado, así que sin auth
# cualquiera que alcance el puerto puede crear containers en el host.
#
# El panel y la API se sirven en el mismo origen, así que el browser pide las
# credenciales una sola vez y las reusa para todas las llamadas.
PANEL_USER=
PANEL_PASSWORD=

# --- Encryption (Sprint 3) ---
# Master key para encriptar los GitHub PATs en la DB (AES-256-GCM).
# Si está vacía, la app genera una en memoria al arranque (DEV ONLY —
# en producción SIEMPRE tiene que estar seteada, sino los PATs se vuelven
# ilegibles al reiniciar y hay que regenerarlos).
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Formato: 64 chars hex (32 bytes).
APP_ENCRYPTION_KEY=
